pipeline {
    agent any

    // 修复说明：
    // 由于无法获取原始的 Job 配置文件（JJB YAML 或 Jenkins UI 配置），此处提供标准的 JJB YAML 配置示例。
    // 解决此问题的关键在于在 SCM 配置中添加 credentials-id。
    // 请将 'your-github-credential-id' 替换为 Jenkins 中实际存储的 GitHub 凭据 ID（通常类型为 'Username with password' 或 'Secret text'）。

    stages {
        stage('Checkout') {
            steps {
                script {
                    // 必须指定 credentialsId 才能访问私有仓库或通过认证
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']], // 请根据实际分支修改
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [],
                        submoduleCfg: [],
                        userRemoteConfigs: [[
                            url: 'https://github.com/bobwei192-star/pipeline.git',
                            credentialsId: 'your-github-credential-id' // 关键修复点
                        ]]
                    ])
                }
            }
        }
    }
}

