// SZ 方案 Deploy OS 冒烟：PE 刷盘 → reboot SUT → wait/reconnect Agent → SUT 验证
//
// 仓库: https://github.com/bobwei192-star/pipeline.git
// Script Path: jenkinsfiles/Jenkinsfile.sz-deploy-smoke
//
// 凭据（Manage Jenkins → Credentials）:
//   sut-lab-ssh   — Username/password: amd / amdyes（SSH reboot）
//   jenkins-api   — Username/password: admin / <JENKINS_TOKEN>（查节点 online）
// Built-In 需: curl, sshpass
//
// PE: ~/ubuntu26.04-minimal-next.pcl.gz
//      ~/pipeline/scripts/slave/deploy_os_in_ci.sh

pipeline {
  agent none

  options {
    disableConcurrentBuilds()
    timeout(time: 3, unit: 'HOURS')
    timestamps()
  }

  parameters {
    string(name: 'NODE_NAME', defaultValue: 'SUT-003', description: 'Jenkins 节点名')
    string(name: 'NODE_IP', defaultValue: '172.31.8.5', description: '测试机 IP')
    string(name: 'PCL_GZ', defaultValue: '/home/amd/ubuntu26.04-minimal-next.pcl.gz',
      description: 'partclone 镜像（在测试机 node 上）')
    string(name: 'GRUB_SUT_ENTRY',
      defaultValue: 'osprober-gnulinux-simple-c0b61a7e-8069-47df-8f09-2fa33abb81ac',
      description: 'SUT 26.04 grub 菜单 ID')
    string(name: 'SCRIPTS_DIR', defaultValue: '/home/amd/pipeline/scripts',
      description: '测试机上 deploy_os_in_ci.sh 所在 scripts 目录')
    string(name: 'SSH_CREDENTIALS_ID', defaultValue: 'sut-lab-ssh',
      description: 'SSH 凭据 ID')
    string(name: 'JENKINS_API_CREDENTIALS_ID', defaultValue: 'jenkins-api',
      description: 'Jenkins API 凭据（admin + API token）')
    string(name: 'JENKINS_BASE_URL',
      defaultValue: 'https://172.31.0.3:18440/jenkins/',
      description: 'Jenkins 根 URL（Built-In 常无 JENKINS_URL，用此兜底）')
    string(name: 'CONTROL_AGENT_LABEL', defaultValue: 'built-in',
      description: '控制端 label；排队失败可改 master')
  }

  environment {
    // Built-In 上系统可能未注入 JENKINS_URL
    SZ_JENKINS_URL = "${params.JENKINS_BASE_URL}"
  }

  stages {
    stage('Checkout') {
      agent { label "${params.CONTROL_AGENT_LABEL}" }
      steps {
        checkout scm
        stash name: 'sz-pipeline', includes: 'jenkinsfiles/**,scripts/master/**'
      }
    }

    stage('Preflight') {
      agent { label "${params.CONTROL_AGENT_LABEL}" }
      steps {
        unstash 'sz-pipeline'
        script {
          withCredentials([
            usernamePassword(
              credentialsId: params.JENKINS_API_CREDENTIALS_ID,
              usernameVariable: 'JENKINS_USER',
              passwordVariable: 'JENKINS_TOKEN'
            )
          ]) {
            def sz = load 'jenkinsfiles/szLab.groovy'
            echo "Node ${params.NODE_NAME} @ ${params.NODE_IP} JENKINS_URL=${env.JENKINS_URL ?: env.SZ_JENKINS_URL}"
            sz.waitForNodeOnline(params.NODE_NAME, 120)
          }
        }
      }
    }

    stage('Deploy OS on PE') {
      agent { label "${params.CONTROL_AGENT_LABEL}" }
      steps {
        unstash 'sz-pipeline'
        script {
          def sz = load 'jenkinsfiles/szLab.groovy'
          node(params.NODE_NAME) {
            sz.partlabelOnNode('PE')
            sh """
              set -e
              test -f '${params.PCL_GZ}' || { echo 'missing ${params.PCL_GZ}'; exit 1; }
              chmod +x '${params.SCRIPTS_DIR}/slave/deploy_os_in_ci.sh'
              '${params.SCRIPTS_DIR}/slave/deploy_os_in_ci.sh' -f '${params.PCL_GZ}'
            """
          }
        }
      }
    }

    stage('Reboot to SUT') {
      agent { label "${params.CONTROL_AGENT_LABEL}" }
      steps {
        unstash 'sz-pipeline'
        script {
          withCredentials([
            usernamePassword(
              credentialsId: params.SSH_CREDENTIALS_ID,
              usernameVariable: 'SSH_USER',
              passwordVariable: 'SSH_PASS'
            )
          ]) {
            sh """
              set -e
              chmod +x scripts/master/ensure_slave_in_pe.sh
              PE_SSH_PASS="\${SSH_PASS}" ./scripts/master/ensure_slave_in_pe.sh \\
                -i '${params.NODE_IP}' -u "\${SSH_USER}" -p "\${SSH_PASS}" -o sut \\
                --grub-sut '${params.GRUB_SUT_ENTRY}' --wait 600
            """
          }
        }
      }
    }

    stage('Wait SUT Agent') {
      agent { label "${params.CONTROL_AGENT_LABEL}" }
      steps {
        unstash 'sz-pipeline'
        script {
          withCredentials([
            usernamePassword(
              credentialsId: params.JENKINS_API_CREDENTIALS_ID,
              usernameVariable: 'JENKINS_USER',
              passwordVariable: 'JENKINS_TOKEN'
            )
          ]) {
            def sz = load 'jenkinsfiles/szLab.groovy'
            sz.waitForNodeOffline(params.NODE_NAME, 180)
            sz.reconnectNode(params.NODE_NAME)
            sz.waitForNodeOnline(params.NODE_NAME, 900)
            echo 'SUT Agent online'
          }
        }
      }
    }

    stage('Verify on SUT') {
      agent { label "${params.CONTROL_AGENT_LABEL}" }
      steps {
        unstash 'sz-pipeline'
        script {
          def sz = load 'jenkinsfiles/szLab.groovy'
          node(params.NODE_NAME) {
            sz.partlabelOnNode('sut-target-os')
            sh '''
              set -e
              uname -a
              systemctl is-active jenkins-agent.service
              systemctl status jenkins-agent.service --no-pager | head -15
              test -f /home/amd/agent.jar
              if mountpoint -q /shared; then
                test -f /shared/lab/agent/node.env && echo "p3 node.env OK"
              else
                echo "WARN: /shared not mounted"
              fi
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo 'PASSED: deploy_os@PE → ensure_slave→SUT → agent reconnect → verify@SUT'
    }
    failure {
      echo 'FAILED — see Console Output; on SUT: journalctl -u jenkins-agent'
    }
  }
}
